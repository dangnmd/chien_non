rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Irregular Verbs Challenge - separate from all Chiên Con collections.
    // The word bank is intentionally shared and editable without an admin password.
    match /verbQuiz_words/{wordId} {
      allow read, create, update, delete: if signedIn();
    }

    match /verbQuiz_rooms/{roomCode} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /participants/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && userId == request.auth.uid;
        allow delete: if signedIn() && (userId == request.auth.uid ||
          get(/databases/$(database)/documents/verbQuiz_rooms/$(roomCode)).data.hostUid == request.auth.uid);
      }
      match /submissions/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && userId == request.auth.uid;
        allow delete: if signedIn() &&
          get(/databases/$(database)/documents/verbQuiz_rooms/$(roomCode)).data.hostUid == request.auth.uid;
      }
    }
  }
}
